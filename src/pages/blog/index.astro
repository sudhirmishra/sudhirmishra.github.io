            font-size: 0.72rem;
        }

        .post-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-main);
            line-height: 1.3;
            transition: color 0.15s ease;
