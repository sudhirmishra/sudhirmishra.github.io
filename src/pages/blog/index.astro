        .search-row {
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 14px;
            width: 17px;
            height: 17px;
            fill: var(--text-muted);
            pointer-events: none;
        }

