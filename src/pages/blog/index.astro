            gap: 12px;
            flex-wrap: wrap;
            padding-top: 6px;
        }

        .post-tags {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .post-tag {
            padding: 4px 10px;
            background: var(--tag-bg);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
