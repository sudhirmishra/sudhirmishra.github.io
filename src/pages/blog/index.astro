            height: 15px;
            fill: currentColor;
        }

        .theme-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            padding: 7px 12px;
