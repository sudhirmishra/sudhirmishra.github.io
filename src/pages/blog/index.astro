        .post-read-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .empty-results {
            display: none;
            text-align: center;
            padding: 50px 20px;
            background: var(--surface);
            border: 1px dashed var(--border-strong);
            border-radius: var(--radius-md);
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Site Footer */
        .site-footer {
            margin-top: 60px;
            padding-top: 24px;
            border-top: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--text-muted);
            flex-wrap: wrap;
            gap: 12px;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .footer-links a:hover {
            color: var(--accent);
        }

        @media (max-width: 640px) {
            .container {
                padding: 20px 16px 60px;
            }

            .site-nav {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .nav-controls {
                width: 100%;
                justify-content: space-between;
            }

            .hero-title {
                font-size: 1.65rem;
            }

            .post-card {
                padding: 18px 18px;
            }

            .post-title {
                font-size: 1.18rem;
            }

            .site-footer {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
