---
export async function getStaticPaths() {
    const rawPosts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

    const sortedPosts = rawPosts.map((p: any) => {
        const slug = p.file.split('/').pop().replace(/\.md$/, '');
        return {
            slug,
            frontmatter: p.frontmatter,
            Content: p.Content,
            file: p.file
        };
    }).sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

    return sortedPosts.map((post, index) => {
        const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
        const nextPost = index > 0 ? sortedPosts[index - 1] : null;

        return {
            params: { slug: post.slug },
            props: {
                post,
                prev: prevPost ? { slug: prevPost.slug, title: prevPost.frontmatter.title } : null,
                next: nextPost ? { slug: nextPost.slug, title: nextPost.frontmatter.title } : null
            }
        };
    });
}

const { post, prev, next } = Astro.props;
const { Content } = post;
const { title, date, description, tags = [], readTime = '5 min read', author = 'Sudhir Mishra' } = post.frontmatter;

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Sudhir Mishra</title>
    <meta name="description" content={description || title}>
    <meta property="og:title" content={`${title} | Sudhir Mishra`}>
    <meta property="og:description" content={description || title}>
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script is:inline>
        (function() {
            try {
                const savedTheme = localStorage.getItem('portfolio-theme') || localStorage.getItem('portfolio_theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        :root {
            --bg-canvas: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --border-subtle: #e2e8f0;
            --border-strong: #cbd5e1;
            --text-main: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #0284c7;
            --accent-bg: #f0f9ff;
            --accent-border: #bae6fd;
            --accent-text: #0369a1;
            --tag-bg: #f1f5f9;
            --tag-border: #e2e8f0;
            --tag-text: #334155;
            --code-bg: #0f172a;
            --code-text: #f8fafc;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-subtle: 0 2px 8px -2px rgba(15, 23, 42, 0.04);
            --shadow-card: 0 4px 16px -3px rgba(15, 23, 42, 0.05);
        }

        [data-theme="dark"] {
            --bg-canvas: #090d16;
            --surface: #111726;
            --surface-hover: #172033;
            --border-subtle: #1e293b;
            --border-strong: #334155;
            --text-main: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --accent-bg: #0c2340;
            --accent-border: #1e3a5f;
            --accent-text: #7dd3fc;
            --tag-bg: #172033;
            --tag-border: #23304a;
            --tag-text: #cbd5e1;
            --code-bg: #020617;
            --code-text: #e2e8f0;
            --shadow-subtle: 0 2px 8px -2px rgba(0, 0, 0, 0.3);
            --shadow-card: 0 4px 16px -3px rgba(0, 0, 0, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.25s ease, color 0.25s ease;
            min-height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 820px;
            margin: 0 auto;
            padding: 32px 24px 90px;
        }

        /* Top Navigation */
        .post-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 20px;
            margin-bottom: 36px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .nav-back-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text-secondary);
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            transition: all 0.15s ease;
        }

        .nav-back-link:hover {
            color: var(--accent);
            border-color: var(--accent);
            background: var(--surface-hover);
        }

        .nav-back-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .action-btn:hover {
            color: var(--text-main);
            border-color: var(--border-strong);
            background: var(--surface-hover);
        }

        .action-btn svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        /* Article Header */
        .article-header {
            margin-bottom: 36px;
        }

        .article-tags {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .article-tag {
            padding: 3px 9px;
            background: var(--tag-bg);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent);
        }

        .article-title {
            font-family: 'Outfit', sans-serif;
            font-size: 2.25rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.25;
            color: var(--text-main);
            margin-bottom: 16px;
        }

        .article-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--text-muted);
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .meta-author {
            color: var(--text-main);
            font-weight: 600;
        }

        .meta-pill {
            background: var(--accent-bg);
            color: var(--accent-text);
            border: 1px solid var(--accent-border);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .article-lead {
            font-size: 1.12rem;
            color: var(--text-secondary);
            line-height: 1.65;
            margin-top: 20px;
            font-weight: 450;
        }

        /* Markdown Article Body Typography */
        .article-content {
            font-size: 1.05rem;
            color: var(--text-secondary);
            line-height: 1.75;
            margin-top: 32px;
        }

        .article-content p {
            margin-bottom: 24px;
            max-width: 68ch;
        }

        .article-content h1,
        .article-content h2,
        .article-content h3,
        .article-content h4 {
            font-family: 'Outfit', sans-serif;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-top: 40px;
            margin-bottom: 16px;
            line-height: 1.3;
        }

        .article-content h1 { font-size: 1.85rem; font-weight: 800; }
        .article-content h2 { 
            font-size: 1.45rem; 
            font-weight: 700;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-subtle);
        }
        .article-content h3 { font-size: 1.2rem; font-weight: 600; }

        .article-content hr {
            border: none;
            border-top: 1px solid var(--border-subtle);
            margin: 36px 0;
        }

        .article-content ul,
        .article-content ol {
            margin-bottom: 24px;
            padding-left: 24px;
            max-width: 68ch;
        }

        .article-content li {
            margin-bottom: 8px;
        }

        .article-content li strong {
            color: var(--text-main);
        }

        .article-content blockquote {
            margin: 28px 0;
            padding: 16px 20px;
            background: var(--surface);
            border-left: 3px solid var(--accent);
            border-top: 1px solid var(--border-subtle);
            border-right: 1px solid var(--border-subtle);
            border-bottom: 1px solid var(--border-subtle);
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            font-style: italic;
            color: var(--text-main);
            font-size: 1rem;
        }

        .article-content blockquote p:last-child {
            margin-bottom: 0;
        }

        /* Inline Code and Code Blocks */
        .article-content :not(pre) > code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85em;
            background: var(--tag-bg);
            border: 1px solid var(--border-subtle);
            color: var(--accent);
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 500;
        }

        .article-content pre {
            margin: 24px 0;
            padding: 18px 20px;
            background: var(--code-bg);
            color: var(--code-text);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            overflow-x: auto;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.88rem;
            line-height: 1.6;
            box-shadow: var(--shadow-subtle);
        }

        .article-content pre code {
            background: transparent;
            border: none;
            padding: 0;
            color: inherit;
            font-size: inherit;
        }

        .article-content strong {
            font-weight: 700;
            color: var(--text-main);
        }

        .article-content a {
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .article-content a:hover {
            color: var(--accent-text);
        }

        /* Author Bio Card */
        .author-card {
            margin-top: 50px;
            padding: 24px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 18px;
            box-shadow: var(--shadow-subtle);
        }

        .author-avatar {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: var(--accent-bg);
            border: 2px solid var(--accent-border);
            color: var(--accent);
            font-family: 'Outfit', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .author-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .author-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .author-desc {
            font-size: 0.88rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        /* Adjacent Post Navigation */
        .adjacent-nav {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 36px;
            padding-top: 24px;
            border-top: 1px solid var(--border-subtle);
        }

        .adjacent-card {
            padding: 16px 18px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            display: flex;
            flex-direction: column;
            gap: 4px;
            transition: all 0.15s ease;
        }

        .adjacent-card:hover {
            border-color: var(--accent);
            background: var(--surface-hover);
        }

        .adjacent-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .adjacent-title {
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-main);
            line-height: 1.35;
        }

        .adjacent-next {
            text-align: right;
            margin-left: auto;
        }

        /* Footer */
        .post-footer {
            margin-top: 60px;
            padding-top: 24px;
            border-top: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--text-muted);
            flex-wrap: wrap;
            gap: 12px;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .footer-links a:hover {
            color: var(--accent);
        }

        @media (max-width: 640px) {
            .container {
                padding: 20px 16px 60px;
            }

            .article-title {
                font-size: 1.7rem;
            }

            .adjacent-nav {
                grid-template-columns: 1fr;
            }

            .adjacent-next {
                text-align: left;
                margin-left: 0;
            }

            .post-footer {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body id="article-body">
    <div class="container" id="article-container">

        <!-- Top Navigation -->
        <nav class="post-nav" id="post-nav" aria-label="Breadcrumb and Actions">
            <div class="nav-back-group">
                <a href="/blog" class="nav-back-link" id="back-to-blog" title="Back to All Articles">
                    <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                    <span>All Articles</span>
                </a>
                <a href="/" class="nav-back-link" id="nav-home" title="Back to Projects">
                    <span>Projects</span>
                </a>
            </div>

            <div class="nav-actions">
                <button type="button" class="action-btn" id="share-btn" title="Copy article link">
                    <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
                    <span id="share-text">Copy Link</span>
                </button>

                <button type="button" class="action-btn" id="theme-toggle" aria-label="Toggle theme">
                    <svg id="theme-icon-moon" viewBox="0 0 24 24" style="display: none;"><path d="M12.3 2a10 10 0 0 0-.19 20 10 10 0 0 0 8.35-4.52 1 1 0 0 0-.82-1.52A8 8 0 0 1 12.3 4a7.92 7.92 0 0 1 1.48.14 1 1 0 0 0 1.13-1.25A10.1 10.1 0 0 0 12.3 2z"/></svg>
                    <svg id="theme-icon-sun" viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0V3a1 1 0 0 0-1-1zm0 18a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0-1-1zm10-9h-2a1 1 0 0 0 0 2h2a1 1 0 0 0 0-2zM4 12a1 1 0 0 0-1-1H1a1 1 0 0 0 0 2h2a1 1 0 0 0 1-1zm14.07-6.07a1 1 0 0 0-1.41 0l-1.42 1.41a1 1 0 1 0 1.41 1.42l1.42-1.42a1 1 0 0 0 0-1.41zM6.76 17.24a1 1 0 0 0-1.42 0l-1.41 1.42a1 1 0 1 0 1.41 1.41l1.42-1.41a1 1 0 0 0 0-1.42zm11.31 1.42l-1.42-1.42a1 1 0 0 0-1.41 1.42l1.42 1.41a1 1 0 0 0 1.41-1.41zM7.17 6.76L5.76 5.34a1 1 0 1 0-1.41 1.42l1.41 1.41a1 1 0 0 0 1.41-1.41z"/></svg>
                    <span id="theme-text">Dark</span>
                </button>
            </div>
        </nav>

        <!-- Article Header -->
        <header class="article-header" id="article-header">
            <div class="article-tags" id="article-tags">
                {tags.map((tag: string) => (
                    <span class="article-tag">#{tag}</span>
                ))}
            </div>

            <h1 class="article-title" id="article-title">{title}</h1>

            <div class="article-meta" id="article-meta">
                <span class="meta-author">By {author}</span>
                <span aria-hidden="true">•</span>
                <time datetime={date}>{formatDate(date)}</time>
                <span aria-hidden="true">•</span>
                <span class="meta-pill">{readTime}</span>
            </div>

            {description && (
                <p class="article-lead">{description}</p>
            )}
        </header>

        <!-- Markdown Rendered Content -->
        <article class="article-content" id="article-body-content">
            <Content />
        </article>

        <!-- Author Bio Section -->
        <section class="author-card" id="author-card" aria-label="About the author">
            <div class="author-avatar" aria-hidden="true">SM</div>
            <div class="author-info">
                <div class="author-name">Sudhir Mishra</div>
                <div class="author-desc">
                    Senior Software Engineer at Cisco focusing on cloud security products, high-throughput streaming systems, and zero-trust data architectures.
                </div>
            </div>
        </section>

        <!-- Adjacent Article Navigation -->
        {(prev || next) && (
            <nav class="adjacent-nav" id="adjacent-nav" aria-label="Adjacent Articles">
                {prev ? (
                    <a href={`/blog/${prev.slug}`} class="adjacent-card adjacent-prev" id="link-prev-post">
                        <span class="adjacent-label">← Previous Article</span>
                        <span class="adjacent-title">{prev.title}</span>
                    </a>
                ) : <div />}

                {next ? (
                    <a href={`/blog/${next.slug}`} class="adjacent-card adjacent-next" id="link-next-post">
                        <span class="adjacent-label">Next Article →</span>
                        <span class="adjacent-title">{next.title}</span>
                    </a>
                ) : <div />}
            </nav>
        )}

        <!-- Footer -->
        <footer class="post-footer" id="article-footer">
            <div>
                <strong>Sudhir Mishra</strong> · Senior Software Engineer
            </div>
            <div class="footer-links">
                <a href="/">Projects</a>
                <a href="/blog">Blog</a>
                <a href="mailto:sudhirxps@gmail.com">Email</a>
                <a href="https://github.com/sudhirmishra" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="https://linkedin.com/in/mishrasudhir" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </div>
        </footer>

    </div>

    <!-- Scripts for theme and copy link -->
    <script is:inline>
        (function() {
            // Theme toggle script
            const themeToggleBtn = document.getElementById('theme-toggle');
            const themeIconSun = document.getElementById('theme-icon-sun');
            const themeIconMoon = document.getElementById('theme-icon-moon');
            const themeText = document.getElementById('theme-text');

            function applyTheme(theme) {
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    if (themeIconSun) themeIconSun.style.display = 'none';
                    if (themeIconMoon) themeIconMoon.style.display = 'block';
                    if (themeText) themeText.textContent = 'Light';
                    localStorage.setItem('portfolio-theme', 'dark');
                    localStorage.setItem('portfolio_theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                    if (themeIconSun) themeIconSun.style.display = 'block';
                    if (themeIconMoon) themeIconMoon.style.display = 'none';
                    if (themeText) themeText.textContent = 'Dark';
                    localStorage.setItem('portfolio-theme', 'light');
                    localStorage.setItem('portfolio_theme', 'light');
                }
            }

            const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            applyTheme(currentTheme);

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    applyTheme(isDark ? 'light' : 'dark');
                });
            }

            // Share / Copy Link
            const shareBtn = document.getElementById('share-btn');
            const shareText = document.getElementById('share-text');
            if (shareBtn) {
                shareBtn.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(window.location.href);
                        if (shareText) {
                            shareText.textContent = 'Copied!';
                            setTimeout(() => {
                                shareText.textContent = 'Copy Link';
                            }, 2000);
                        }
                    } catch (e) {
                        // fallback
                    }
                });
            }
        })();
    </script>
</body>
</html>
