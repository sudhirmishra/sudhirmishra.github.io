---
import { projects } from '../data/projects';

const totalCount = projects.length;
const securityCount = projects.filter(p => p.categories.includes('security')).length;
const dataCount = projects.filter(p => p.categories.includes('data')).length;
const webCount = projects.filter(p => p.categories.includes('web')).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sudhir Mishra | Senior Software Engineer</title>
    <meta name="description" content="Sudhir Mishra - Senior Software Engineer | Security Products, Web Applications & Data Systems">
    <meta property="og:title" content="Sudhir Mishra | Senior Software Engineer">
    <meta property="og:description" content="Sudhir Mishra - Senior Software Engineer | Security Products, Web Applications & Data Systems">
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script is:inline>
        (function() {
            try {
                const savedTheme = localStorage.getItem('portfolio-theme') || localStorage.getItem('portfolio_theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        :root {
            --bg-canvas: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --border-subtle: #e2e8f0;
            --border-strong: #cbd5e1;
            --text-main: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #0284c7;
            --accent-bg: #f0f9ff;
            --accent-border: #bae6fd;
            --accent-text: #0369a1;
            --featured-bg: #ecfdf5;
            --featured-border: #a7f3d0;
            --featured-text: #065f46;
            --tag-bg: #f1f5f9;
            --tag-border: #e2e8f0;
            --tag-text: #334155;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-subtle: 0 2px 8px -2px rgba(15, 23, 42, 0.04);
            --shadow-card: 0 4px 16px -3px rgba(15, 23, 42, 0.05);
        }

        [data-theme="dark"] {
            --bg-canvas: #090d16;
            --surface: #111726;
            --surface-hover: #172033;
            --border-subtle: #1e293b;
            --border-strong: #334155;
            --text-main: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --accent-bg: #0c2340;
            --accent-border: #1e3a5f;
            --accent-text: #7dd3fc;
            --featured-bg: #062b20;
            --featured-border: #0d5f46;
            --featured-text: #6ee7b7;
            --tag-bg: #172033;
            --tag-border: #23304a;
            --tag-text: #cbd5e1;
            --shadow-subtle: 0 2px 8px -2px rgba(0, 0, 0, 0.3);
            --shadow-card: 0 4px 16px -3px rgba(0, 0, 0, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        html {
            scroll-behavior: smooth;
        }

        /* Container Layout: Two-column desktop, single-column mobile */
        .site-shell {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 40px;
            min-height: 100vh;
        }

        @media (min-width: 1024px) {
            .site-shell {
                display: flex;
                justify-content: space-between;
                gap: 56px;
            }

            .sidebar-pane {
                position: sticky;
                top: 0;
                width: 360px;
                min-width: 320px;
                height: 100vh;
                padding: 56px 0 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: var(--border-subtle) transparent;
            }

            .sidebar-pane::-webkit-scrollbar {
                width: 4px;
            }
            .sidebar-pane::-webkit-scrollbar-thumb {
                background: var(--border-subtle);
                border-radius: 4px;
            }

            .main-content-pane {
                flex: 1;
                min-width: 0;
                padding: 56px 0 88px;
            }
        }

        @media (max-width: 1023px) {
            .site-shell {
                padding: 32px 20px 64px;
            }

            .sidebar-pane {
                width: 100%;
                margin-bottom: 40px;
                padding-bottom: 28px;
                border-bottom: 1px solid var(--border-subtle);
            }

            .main-content-pane {
                width: 100%;
            }
        }

        /* Sidebar Profile & Typography */
        .sidebar-top {
            display: flex;
            flex-direction: column;
        }

        .profile-header {
            margin-bottom: 20px;
        }

        .profile-name {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(2rem, 3.5vw, 2.65rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.12;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .profile-headline {
            font-size: 1.12rem;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 4px;
            letter-spacing: -0.015em;
        }

        .profile-subheadline {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 14px;
            letter-spacing: -0.01em;
        }

        .profile-bio {
            font-size: 0.94rem;
            color: var(--text-muted);
            line-height: 1.62;
        }

        /* Sidebar Dividers */
        .sidebar-divider {
            height: 1px;
            background-color: var(--border-subtle);
            margin: 20px 0;
            border: none;
        }

        /* Sidebar Timeline */
        .timeline-section {
            display: flex;
            flex-direction: column;
        }

        .timeline-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .timeline-header-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .timeline-scroll-hint {
            display: none;
        }

        .timeline-list {
            list-style: none;
            padding: 0 0 0 4px;
            margin: 0;
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .timeline-list::before {
            content: '';
            position: absolute;
            left: 9px;
            top: 6px;
            bottom: 12px;
            width: 2px;
            background: var(--border-subtle);
        }

        .timeline-item {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .timeline-stem,
        .timeline-spacer,
        .timeline-dot-year {
            display: none;
        }

        .timeline-marker {
            order: 1;
            position: relative;
            z-index: 2;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--surface);
            border: 2px solid var(--accent);
            margin-top: 3px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .timeline-marker.edu {
            border-color: var(--border-strong);
            background: var(--surface);
        }

        .timeline-item:hover .timeline-marker,
        .timeline-content.show-popover ~ .timeline-marker {
            border-color: var(--accent);
            background: var(--accent);
            transform: scale(1.2);
            box-shadow: 0 0 0 3px var(--accent-bg);
        }

        .timeline-content {
            order: 2;
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
            flex: 1;
        }

        .timeline-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .timeline-org-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .timeline-org {
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .timeline-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            padding: 1px 6px;
            border-radius: 4px;
            background: var(--surface-hover);
            color: var(--text-muted);
            border: 1px solid var(--border-subtle);
        }

        .timeline-badge.current {
            background: var(--featured-bg);
            color: var(--featured-text);
            border-color: var(--featured-border);
        }

        .timeline-period {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--accent);
            font-weight: 600;
        }

        .timeline-role {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-secondary);
            line-height: 1.35;
        }

        .timeline-location {
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        .timeline-info-trigger {
            background: var(--surface-hover);
            border: 1px solid var(--border-subtle);
            color: var(--accent);
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10.5px;
            font-weight: 700;
            cursor: pointer;
            padding: 0;
            flex-shrink: 0;
            transition: all 0.15s ease;
        }

        .timeline-info-trigger:hover,
        .timeline-info-trigger:focus-visible,
        .timeline-content.show-popover .timeline-info-trigger {
            background: var(--accent);
            color: #ffffff;
            border-color: var(--accent);
            transform: scale(1.08);
        }

        .timeline-popover {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            background: var(--surface);
            border: 1px solid var(--accent);
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            box-shadow: var(--shadow-card);
            z-index: 30;
            display: flex;
            flex-direction: column;
            gap: 6px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(-4px);
            transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
        }

        .timeline-content.show-popover .timeline-popover {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

        .popover-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 4px;
        }

        .popover-org {
            font-family: 'Outfit', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .popover-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
            width: 26px;
            height: 26px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border-radius: 4px;
            margin: -2px -2px -2px 0;
            transition: color 0.15s ease, background-color 0.15s ease;
        }

        .popover-close:hover,
        .popover-close:focus-visible {
            color: var(--text-main);
            background: var(--surface-hover);
        }

        .popover-body {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .popover-meta-item {
            display: flex;
            flex-direction: column;
            gap: 1px;
        }

        .popover-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 9.5px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .popover-val {
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-weight: 500;
            line-height: 1.35;
        }

        /* Mobile Timeline Adjustments */
        @media (max-width: 899px) {
            .timeline-section {
                margin-top: 16px;
                margin-bottom: 12px;
            }

            .timeline-header-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 8px;
            }

            .timeline-scroll-hint {
                display: none !important;
            }

            .timeline-list::before {
                display: none !important;
            }

            .timeline-list {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                align-items: center;
                overflow: visible;
                padding: 10px 0;
                margin: 0;
                gap: 0;
                width: 100%;
                box-sizing: border-box;
                position: relative;
            }

            .timeline-item {
                position: relative;
                width: 100%;
                height: 118px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 0 2px;
                box-sizing: border-box;
            }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                top: 50%;
                height: 2px;
                background: var(--border-strong);
                transform: translateY(-50%);
                z-index: 1;
                display: block !important;
            }

            .timeline-item:first-child::before {
                left: 50%;
            }

            .timeline-item:last-child::before {
                right: 50%;
            }

            .timeline-stem,
            .timeline-spacer {
                display: none !important;
            }

            .timeline-marker {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: var(--surface);
                border: 2px solid var(--accent);
                margin: 0;
                z-index: 3;
                flex-shrink: 0;
                transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            }

            .timeline-marker.edu {
                border-color: var(--text-muted);
            }

            .timeline-item:hover .timeline-marker,
            .timeline-content.show-popover ~ .timeline-marker,
            .timeline-marker:has(~ .timeline-content.show-popover) {
                border-color: var(--accent);
                background: var(--accent);
                transform: translate(-50%, -50%) scale(1.3);
                box-shadow: 0 0 0 3px var(--accent-bg);
            }

            .timeline-dot-year {
                position: absolute;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 1px;
                font-family: 'JetBrains Mono', monospace;
                font-size: 9.5px;
                font-weight: 600;
                color: var(--text-muted);
                background: transparent !important;
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                height: auto !important;
                white-space: nowrap;
                z-index: 3;
                left: 50%;
                transform: translateX(-50%);
                transition: color 0.2s ease, transform 0.2s ease;
            }

            .timeline-top .timeline-dot-year {
                top: calc(50% + 12px);
            }

            .timeline-bottom .timeline-dot-year {
                bottom: calc(50% + 12px);
            }

            .timeline-dot-year .year-primary {
                font-weight: 700;
                color: var(--text-muted);
            }

            #tl-cisco .timeline-dot-year .year-primary {
                color: var(--text-main);
            }

            #tl-cisco .timeline-dot-year .year-range {
                color: var(--accent);
                font-weight: 700;
            }

            .timeline-item:hover .timeline-dot-year,
            .timeline-content.show-popover ~ .timeline-dot-year,
            .timeline-dot-year:has(~ .timeline-content.show-popover) {
                color: var(--accent-text);
            }

            .timeline-content {
                order: initial;
                position: absolute;
                width: max-content;
                max-width: 100%;
                height: auto !important;
                min-height: 0 !important;
                max-height: none !important;
                background: transparent !important;
                border: none !important;
                box-shadow: none !important;
                border-radius: 0;
                padding: 0 !important;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 4;
                box-sizing: border-box;
                white-space: nowrap;
            }

            .timeline-top .timeline-content {
                bottom: calc(50% + 12px);
                left: 50%;
                transform: translateX(-50%);
            }

            .timeline-bottom .timeline-content {
                top: calc(50% + 12px);
                left: 50%;
                transform: translateX(-50%);
            }

            .timeline-content .timeline-period,
            .timeline-content .timeline-role,
            .timeline-content .timeline-location {
                display: none !important;
            }

            .timeline-card-header {
                display: inline-flex;
                align-items: flex-start;
                justify-content: center;
                gap: 2px;
                width: auto;
                cursor: pointer;
            }

            .timeline-org-row {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2px;
                text-align: center;
            }

            .timeline-org {
                font-size: 0.84rem;
                font-weight: 700;
                color: var(--text-main);
                line-height: 1.15;
                white-space: nowrap;
                text-align: center;
            }

            #tl-bits .timeline-org {
                display: flex;
                flex-direction: column;
                align-items: center;
                line-height: 1.15;
            }

            #tl-bits .timeline-org .org-word {
                display: block;
            }

            #tl-bits .timeline-org .org-word:first-child {
                font-size: 0.84rem;
                font-weight: 700;
                color: var(--text-main);
            }

            #tl-bits .timeline-org .org-word:last-child {
                font-size: 0.74rem;
                font-weight: 600;
                color: var(--text-muted);
            }

            #tl-bits .timeline-org .org-sep {
                display: none;
            }

            #tl-bits .timeline-badge,
            #tl-ddit .timeline-badge {
                font-family: 'JetBrains Mono', monospace;
                font-size: 8px;
                line-height: 1;
                padding: 1.5px 4.5px;
                border-radius: 3px;
                font-weight: 700;
                letter-spacing: 0.03em;
                background: var(--surface-hover);
                color: var(--text-muted);
                border: 1px solid var(--border-subtle);
                margin-top: 1px;
            }

            .timeline-info-trigger {
                position: relative;
                width: 13px;
                height: 13px;
                font-size: 9px;
                font-weight: 700;
                line-height: 1;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: transparent;
                border: 1px solid var(--border-subtle);
                color: var(--text-muted);
                padding: 0;
                flex-shrink: 0;
                transition: all 0.15s ease;
                margin-top: 2px;
            }

            .timeline-info-trigger::after {
                content: '';
                position: absolute;
                inset: -10px;
            }

            .timeline-card-header:hover .timeline-info-trigger,
            .timeline-content.show-popover .timeline-info-trigger {
                border-color: var(--accent);
                color: var(--accent-text);
                background: var(--accent-bg);
            }

            .timeline-popover {
                position: absolute;
                z-index: 50;
                width: 240px;
                max-width: calc(100vw - 32px);
                background: var(--surface);
                border: 1.5px solid var(--accent);
                border-radius: var(--radius-sm);
                padding: 10px 12px;
                box-shadow: 0 8px 24px -2px rgba(0, 0, 0, 0.25);
                display: flex;
                flex-direction: column;
                gap: 6px;
                box-sizing: border-box;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
                white-space: normal;
                text-align: left;
            }

            .timeline-top .timeline-popover {
                top: calc(100% + 8px);
                bottom: auto;
            }

            .timeline-bottom .timeline-popover {
                top: auto;
                bottom: calc(100% + 8px);
            }

            #tl-cisco .timeline-popover {
                left: 0;
                right: auto;
                transform: scale(0.96);
                transform-origin: top left;
            }

            #tl-bits .timeline-popover {
                left: 50%;
                right: auto;
                transform: translateX(-35%) scale(0.96);
                transform-origin: bottom center;
            }

            #tl-tatvic .timeline-popover {
                right: auto;
                left: 50%;
                transform: translateX(-65%) scale(0.96);
                transform-origin: top center;
            }

            #tl-ddit .timeline-popover {
                right: 0;
                left: auto;
                transform: scale(0.96);
                transform-origin: bottom right;
            }

            .timeline-content.show-popover .timeline-popover {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            #tl-cisco .timeline-content.show-popover .timeline-popover {
                transform: scale(1);
            }

            #tl-bits .timeline-content.show-popover .timeline-popover {
                transform: translateX(-35%) scale(1);
            }

            #tl-tatvic .timeline-content.show-popover .timeline-popover {
                transform: translateX(-65%) scale(1);
            }

            #tl-ddit .timeline-content.show-popover .timeline-popover {
                transform: scale(1);
            }

            .popover-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 6px;
                border-bottom: 1px solid var(--border-subtle);
                padding-bottom: 4px;
                margin-bottom: 2px;
            }

            .popover-org {
                font-size: 0.88rem;
                font-weight: 700;
                color: var(--text-main);
                line-height: 1.2;
            }

            .popover-close {
                width: 28px;
                height: 28px;
                font-size: 20px;
                line-height: 1;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
            }

            .popover-body {
                display: flex;
                flex-direction: column;
                gap: 5px;
                overflow-y: auto;
                max-height: 140px;
            }

            .popover-meta-item {
                display: flex;
                flex-direction: column;
                gap: 1px;
            }

            .popover-label {
                font-size: 9px;
                font-weight: 700;
                color: var(--accent);
                text-transform: uppercase;
                letter-spacing: 0.04em;
                line-height: 1.2;
            }

            .popover-val {
                font-size: 0.78rem;
                font-weight: 500;
                color: var(--text-secondary);
                line-height: 1.3;
            }
        }

        /* Sidebar Bottom & Socials */
        .sidebar-bottom {
            margin-top: 24px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-socials {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-secondary);
            transition: all 0.15s ease;
        }

        .social-link:hover {
            color: var(--text-main);
            border-color: var(--border-strong);
            background-color: var(--surface-hover);
        }

        .social-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .sidebar-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .theme-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .theme-toggle-btn:hover {
            border-color: var(--border-strong);
            color: var(--text-main);
            background: var(--surface-hover);
        }

        .theme-toggle-btn svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        /* Section Layout */
        .section {
            margin-bottom: 60px;
            scroll-margin-top: 40px;
        }

        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .section-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-main);
        }

        .section-subtitle {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* Filter & Search Bar */
        .project-controls {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 24px;
        }

        .search-and-filters {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 500;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .filter-btn:hover {
            background-color: var(--surface-hover);
            color: var(--text-main);
        }

        .filter-btn.active {
            background-color: var(--text-main);
            border-color: var(--text-main);
            color: var(--bg-canvas);
            font-weight: 600;
        }

        .search-wrapper {
            position: relative;
            min-width: 250px;
            flex-grow: 1;
            max-width: 360px;
        }

        .search-input {
            width: 100%;
            padding: 7px 12px 7px 32px;
            font-size: 13px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-main);
            outline: none;
            transition: border-color 0.15s ease;
        }

        .search-input:focus {
            border-color: var(--accent);
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            fill: var(--text-muted);
            pointer-events: none;
        }

        /* Projects Grid */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .project-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            box-shadow: var(--shadow-subtle);
        }

        .project-card:hover {
            border-color: var(--border-strong);
            box-shadow: var(--shadow-card);
        }

        .project-card.hidden {
            display: none;
        }

        .card-top-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .project-category-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .featured-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10.5px;
            font-weight: 600;
            padding: 2px 8px;
            background: var(--featured-bg);
            border: 1px solid var(--featured-border);
            color: var(--featured-text);
            border-radius: 9999px;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .project-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.22rem;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--text-main);
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .project-summary {
            font-size: 0.93rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 14px;
            flex-grow: 1;
        }

        .case-study-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 14px;
            transition: all 0.15s ease;
            text-decoration: none;
            width: fit-content;
        }

        .case-study-link:hover {
            color: var(--text-main);
            transform: translateX(3px);
        }

        .case-study-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
            transition: transform 0.15s ease;
        }

        .case-study-link:hover svg {
            transform: translateX(2px);
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px dashed var(--border-subtle);
        }

        .tag-pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            padding: 3px 8px;
            background: var(--tag-bg);
            border: 1px solid var(--tag-border);
            border-radius: 4px;
            color: var(--tag-text);
            white-space: nowrap;
        }

        /* Adjacent / Secondary Projects */
        .adjacent-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 20px 24px;
            margin-top: 24px;
        }

        .adjacent-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .adjacent-list {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px 24px;
        }

        .adjacent-item {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.5;
            position: relative;
            padding-left: 14px;
        }

        .adjacent-item::before {
            content: "•";
            position: absolute;
            left: 0;
            color: var(--accent);
            font-weight: bold;
        }

        .adjacent-item strong {
            color: var(--text-main);
        }

        /* Empty Search State */
        .empty-results {
            display: none;
            text-align: center;
            padding: 48px 20px;
            background: var(--surface);
            border: 1px dashed var(--border-subtle);
            border-radius: var(--radius-md);
            color: var(--text-muted);
            font-size: 0.95rem;
            grid-column: span 2;
        }

        /* Footer */
        .site-footer {
            margin-top: 64px;
            border-top: 1px solid var(--border-subtle);
            padding-top: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .footer-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-main);
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .footer-action:hover {
            color: var(--accent);
        }

        /* Responsive */
        @media (max-width: 820px) {
            .site-shell {
                padding: 28px 18px 60px;
            }

            .projects-grid {
                grid-template-columns: 1fr;
            }

            .adjacent-list {
                grid-template-columns: 1fr;
            }

            .search-wrapper {
                max-width: 100%;
                width: 100%;
            }

            .empty-results {
                grid-column: span 1;
            }
        }
    </style>
</head>
