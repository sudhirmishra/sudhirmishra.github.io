                        <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 1.64 1.64 1.64 1.64 0 0 0-1.64-1.64z"/></svg>
                    </a>
                </div>

                <div class="rail-bottom">
                    <button type="button" class="rail-action-btn" id="rail-theme-toggle" title="Toggle light and dark mode" aria-label="Toggle theme">
                        <svg class="rail-icon-sun" viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0V3a1 1 0 0 0-1-1zm0 18a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0-1-1zm10-9h-2a1 1 0 0 0 0 2h2a1 1 0 0 0 0-2zM4 12a1 1 0 0 0-1-1H1a1 1 0 0 0 0 2h2a1 1 0 0 0 1-1zm14.07-6.07a1 1 0 0 0-1.41 0l-1.42 1.41a1 1 0 1 0 1.41 1.42l1.42-1.42a1 1 0 0 0 0-1.41zM6.76 17.24a1 1 0 0 0-1.42 0l-1.41 1.42a1 1 0 1 0 1.41 1.41l1.42-1.41a1 1 0 0 0 0-1.42zm11.31 1.42l-1.42-1.42a1 1 0 0 0-1.41 1.42l1.42 1.41a1 1 0 0 0 1.41-1.41zM7.17 6.76L5.76 5.34a1 1 0 1 0-1.41 1.42l1.41 1.41a1 1 0 0 0 1.41-1.41z"/></svg>
                        <svg class="rail-icon-moon" viewBox="0 0 24 24" style="display: none;"><path d="M12.3 2a10 10 0 0 0-.19 20 10 10 0 0 0 8.35-4.52 1 1 0 0 0-.82-1.52A8 8 0 0 1 12.3 4a7.92 7.92 0 0 1 1.48.14 1 1 0 0 0 1.13-1.25A10.1 10.1 0 0 0 12.3 2z"/></svg>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content Pane -->
        <main class="main-content-pane" id="main-content-pane">

            <!-- Featured Projects Section -->
            <section class="section" id="projects-section">
                <div class="section-header" id="proj-header">
                    <div>
                        <h2 class="section-title" id="proj-title">Featured Projects</h2>
                        <span class="section-subtitle" id="proj-subtitle">Production security products, cloud data platforms, and performant web systems</span>
                    </div>
                </div>

                <div class="project-controls" id="project-controls">
                    <div class="search-and-filters" id="search-and-filters">
                        <div class="filter-tabs" id="filter-tabs" role="tablist" aria-label="Filter projects">
                            <button class="filter-btn active" data-filter="all" id="btn-filter-all" role="tab" aria-selected="true">All Projects ({totalCount})</button>
                            <button class="filter-btn" data-filter="security" id="btn-filter-security" role="tab" aria-selected="false">Security ({securityCount})</button>
                            <button class="filter-btn" data-filter="data" id="btn-filter-data" role="tab" aria-selected="false">Data Systems ({dataCount})</button>
                            <button class="filter-btn" data-filter="web" id="btn-filter-web" role="tab" aria-selected="false">Web &amp; Open Source ({webCount})</button>
                        </div>

                        <div class="search-wrapper" id="search-wrapper">
                            <svg class="search-icon" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                            <input type="text" class="search-input" id="project-search" placeholder="Search projects by stack, challenge, keyword..." aria-label="Search projects">
                        </div>
                    </div>
                </div>

                <!-- Projects Grid rendered dynamically with clean titles (no numbers) -->
                <div class="projects-grid" id="projects-grid">
                    {projects.map((p) => (
                        <div class="project-card" data-category={p.categories} data-featured={p.order <= 6 ? 'true' : 'false'} data-keywords={`${p.keywords} ${p.summary}`} id={`project-card-${p.id}`}>
                            <div>
                                <div class="card-top-meta">
                                    <span class="project-category-tag">{p.metaPill}</span>
                                    <span class="featured-badge">Project</span>
                                </div>
                                <h3 class="project-name">{p.title}</h3>
                                <a href={`#project-${p.id}`} class="case-study-link" id={`link-study-${p.id}`} data-project-id={p.id}>
                                    <span>View Project</span>
                                    <svg viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-7.85-1.42 1.42 5.43 5.43H5v2z"/></svg>
                                </a>
                            </div>
                            <div class="project-tags">
                                {p.stack.map((tech) => (
                                    <span class="tag-pill">{tech}</span>
                                ))}
                            </div>
                        </div>
                    ))}

                    <div class="empty-results" id="empty-search-message">
                        No matching projects found. Try adjusting your keyword or filter criteria.
                    </div>
                </div>

                <!-- Additional Engineering Initiatives & Projects -->
                <div class="adjacent-card" id="adjacent-projects-card">
                    <h3 class="adjacent-title" id="adjacent-heading">
                        <span>Additional Engineering Initiatives &amp; Projects</span>
                    </h3>
                    <ul class="adjacent-list" id="adjacent-list">
                        <li class="adjacent-item">
                            <strong>Outlook Security Add-in:</strong> Mailbox-level security actions, cross-platform Office JS integration, and client-side remediation.
                        </li>
                        <li class="adjacent-item">
                            <strong>Email Filtering Engine Modernization:</strong> Content filtering caching layers, regression test coverage, and compatibility adapters.
                        </li>
                        <li class="adjacent-item">
                            <strong>Mobile Pixel Tracking &amp; Churn Analytics:</strong> Android SDK event capture, CloudFront/S3 ingestion, and churn modeling pipelines.
                        </li>
                        <li class="adjacent-item">
                            <strong>Centralized Auth &amp; Authorization:</strong> IAM-based access governance across Redshift, RDS, and OpenSearch with credential hardening.
                        </li>
                        <li class="adjacent-item">
                            <strong>Product Hunt Curated Video App:</strong> Independent web experiment featured on Product Hunt with public API ingestion and leaderboard ranking.
                        </li>
                        <li class="adjacent-item">
                            <strong>360-Degree Enterprise Customer View:</strong> Cross-platform customer data consolidation integrating disparate enterprise transactional systems.
                        </li>
                    </ul>
                </div>
            </section>

            <!-- In-Page Project View (Continuous Vertical Project Stream with Sticky Vertical Rail) -->
            <div class="case-study-view" id="case-study-view" style="display: none;" aria-live="polite">
                <!-- Mobile Fixed Reading Progress Bar (Very thin, at the very top like a loading bar) -->
                <div class="mobile-reading-progress" id="mobile-reading-progress" aria-hidden="true">
                    <div class="mobile-reading-progress-fill" id="mobile-reading-progress-fill"></div>
                </div>

                <div class="vertical-projects-layout">
                    <!-- Desktop Sticky Vertical Navigation Rail -->
                    <aside class="vertical-nav-rail" id="vertical-nav-rail" aria-label="Projects Table of Contents">
                        <div class="vnav-header">
                            <span class="vnav-label">Projects ({totalCount})</span>
                            <button type="button" class="vnav-grid-btn" id="vnav-grid-btn" title="Back to 2-column Grid Overview">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 16h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4z"/></svg>
                                <span>Grid View</span>
                            </button>
                        </div>
                        <nav class="vnav-list" role="navigation">
                            {projects.map((p, index) => (
                                <button
                                    type="button"
                                    class="vnav-link"
                                    id={`vnav-link-${p.id}`}
                                    data-project-id={p.id}
                                    title={p.title}
                                >
                                    <span class="vnav-index">{String(index + 1).padStart(2, '0')}</span>
                                    <span class="vnav-title">{p.title}</span>
                                </button>
                            ))}
                        </nav>
                    </aside>

                    <!-- Continuous Vertical Project Stream (Snackable 1-View Cards) -->
                    <div class="vertical-projects-stream" id="vertical-projects-stream">
                        <!-- Mobile Top Return to Grid Bar -->
                        <div class="mobile-stream-top-bar" id="mobile-stream-top-bar">
                            <button type="button" class="mobile-stream-grid-btn" id="mobile-stream-grid-btn" title="Back to Grid View">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                                <span>Back to Grid View</span>
                            </button>
                        </div>

                        <!-- Mobile Floating Return to Grid Button (Bottom corner) -->
                        <button type="button" class="mobile-stream-floating-btn" id="mobile-stream-floating-btn" title="Back to Grid View" aria-label="Back to Grid View">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 16h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4z"/></svg>
                            <span>Grid View</span>
                        </button>

                        {projects.map((p, index) => (
                            <article class="case-study-card snackable-card" id={`project-card-view-${p.id}`} data-project-id={p.id}>
                                <div class="project-heading-block">
                                    <div class="project-heading-top">
                                        <span class="project-meta-pill">{p.metaPill}</span>
                                        <span class="project-view-index">#{String(index + 1).padStart(2, '0')}</span>
                                    </div>
                                    <h2 class="project-title">{p.title}</h2>
                                </div>

                                <div class="snackable-content-grid">
                                    <section class="study-section full-span">
                                        <h4 class="section-label">Challenge</h4>
                                        <p class="section-body">{p.challenge}</p>
                                    </section>

                                    <section class="study-section">
                                        <h4 class="section-label">Approach</h4>
                                        <ul class="approach-list">
                                            {p.approach.map(item => (
                                                <li>{item}</li>
                                            ))}
                                        </ul>
                                    </section>

                                    <div class="study-section-stacked">
                                        <section class="study-section">
                                            <h4 class="section-label">Outcome</h4>
                                            <p class="section-body">{p.outcome}</p>
                                        </section>

                                        <section class="study-section stack-section" style="margin-top: 8px;">
                                            <h4 class="section-label">Stack</h4>
                                            <div class="stack-tags">
                                                {p.stack.map(tech => (
                                                    <span class="stack-pill">{tech}</span>
                                                ))}
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Mobile Floating Button to jump back to Projects from deep vertical scroll on main page -->
            <button type="button" class="mobile-jump-projects" id="mobile-jump-projects" aria-label="Jump back to Projects section">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-8 8h5v8h6v-8h5z"/></svg>
                <span>Back to Projects</span>
            </button>

            <!-- Footer -->
            <footer class="site-footer" id="site-footer">
                <div id="footer-author">Sudhir Mishra · Portfolio</div>
                <a href="mailto:sudhirxps@gmail.com" class="footer-action" id="footer-contact-link">
                    <span>sudhirxps@gmail.com</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-7.85-1.42 1.42 5.43 5.43H5v2z"/></svg>
                </a>
            </footer>

        </main>
    </div>

    <!-- Serialized projects data for instant in-page transitions -->
    <script id="projects-data" type="application/json" set:html={JSON.stringify(projects)} />

    <!-- Client-side Scripts -->
    <script is:inline>
        (function() {
            // Theme Management
            const themeToggleBtn = document.getElementById('theme-toggle');
            const iconSun = document.getElementById('theme-icon-sun');
            const iconMoon = document.getElementById('theme-icon-moon');
            const themeText = document.getElementById('theme-text');
            const htmlElement = document.documentElement;

            const railThemeToggleBtn = document.getElementById('rail-theme-toggle');
            const railIconSun = document.querySelector('.rail-icon-sun');
            const railIconMoon = document.querySelector('.rail-icon-moon');

            function syncRailThemeIcons(theme) {
                if (theme === 'dark') {
                    if (railIconSun) railIconSun.style.display = 'inline-block';
                    if (railIconMoon) railIconMoon.style.display = 'none';
                } else {
                    if (railIconSun) railIconSun.style.display = 'none';
                    if (railIconMoon) railIconMoon.style.display = 'inline-block';
                }
            }

            function applyTheme(theme) {
                if (theme === 'dark') {
                    htmlElement.setAttribute('data-theme', 'dark');
                    if (iconSun) iconSun.style.display = 'inline-block';
                    if (iconMoon) iconMoon.style.display = 'none';
                    if (themeText) themeText.textContent = 'Light Mode';
                } else {
                    htmlElement.removeAttribute('data-theme');
                    if (iconSun) iconSun.style.display = 'none';
                    if (iconMoon) iconMoon.style.display = 'inline-block';
                    if (themeText) themeText.textContent = 'Dark Mode';
                }
                syncRailThemeIcons(theme);
            }

            // Detect preferred or stored theme
            const storedTheme = localStorage.getItem('portfolio-theme') || localStorage.getItem('portfolio_theme');
            const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            if (storedTheme) {
                applyTheme(storedTheme);
            } else if (systemPrefersDark) {
                applyTheme('dark');
            } else {
                applyTheme('light');
            }

            function toggleThemeMode() {
                const currentTheme = htmlElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
                localStorage.setItem('portfolio-theme', nextTheme);
                localStorage.setItem('portfolio_theme', nextTheme);
                applyTheme(nextTheme);
            }

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', toggleThemeMode);
            }

            if (railThemeToggleBtn) {
                railThemeToggleBtn.addEventListener('click', toggleThemeMode);
            }

            // Project Filtering and Search
            const filterButtons = document.querySelectorAll('.filter-btn');
            const searchInput = document.getElementById('project-search');
            const projectCards = document.querySelectorAll('.project-card');
            const emptyMessage = document.getElementById('empty-search-message');

            let currentFilter = 'all';
            let currentSearch = '';

            function updateProjectVisibility() {
                let visibleCount = 0;
                const searchLower = currentSearch.toLowerCase().trim();

                projectCards.forEach(card => {
                    const category = card.getAttribute('data-category') || '';
                    const isFeatured = card.getAttribute('data-featured') === 'true';
                    const keywords = card.getAttribute('data-keywords') || '';
                    const text = (card.innerText || '').toLowerCase();

                    // Category filter logic
                    let matchesCategory = false;
                    if (currentFilter === 'featured') {
                        matchesCategory = isFeatured;
                    } else if (currentFilter === 'all') {
                        matchesCategory = true;
                    } else {
                        matchesCategory = category.split(' ').includes(currentFilter);
                    }

                    // Search filter logic
                    const matchesSearch = !searchLower || text.includes(searchLower) || keywords.toLowerCase().includes(searchLower);

                    if (matchesCategory && matchesSearch) {
                        card.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                if (emptyMessage) {
                    if (visibleCount === 0) {
                        emptyMessage.style.display = 'block';
                    } else {
                        emptyMessage.style.display = 'none';
                    }
                }
            }

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterButtons.forEach(b => {
                        b.classList.remove('active');
                        b.setAttribute('aria-selected', 'false');
                    });
                    btn.classList.add('active');
                    btn.setAttribute('aria-selected', 'true');
                    currentFilter = btn.getAttribute('data-filter');
                    updateProjectVisibility();
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    currentSearch = e.target.value;
                    updateProjectVisibility();
                });
            }

            // Initial view
            updateProjectVisibility();

            // Vertical Projects Stream & Sticky Vertical Rail
            const projectsDataEl = document.getElementById('projects-data');
            const allProjects = projectsDataEl ? JSON.parse(projectsDataEl.textContent || '[]') : [];

            const siteShell = document.getElementById('site-shell');
            const projectsSection = document.getElementById('projects-section');
            const caseStudyView = document.getElementById('case-study-view');

            const vnavGridBtn = document.getElementById('vnav-grid-btn');
            const mobileProgressFill = document.getElementById('mobile-reading-progress-fill');
            const mobileStreamGridBtn = document.getElementById('mobile-stream-grid-btn');
            const mobileStreamFloatingBtn = document.getElementById('mobile-stream-floating-btn');
            const railExpandBtn = document.getElementById('rail-expand-btn');
            const mobileJumpProjects = document.getElementById('mobile-jump-projects');

            let activeProjectId = null;
            let isUserScrollingProgrammatically = false;

            function updateMobileProgressBar() {
                if (!caseStudyView || caseStudyView.style.display === 'none' || !mobileProgressFill) {
                    if (mobileProgressFill) mobileProgressFill.style.width = '0%';
                    return;
                }
                const docEl = document.documentElement;
                const scrollTop = window.scrollY || docEl.scrollTop || 0;
                const viewTop = caseStudyView.offsetTop || 0;
                const viewHeight = caseStudyView.offsetHeight || 1;
                const clientHeight = window.innerHeight || docEl.clientHeight || 1;

                const scrollableDistance = viewHeight - clientHeight;
                let progress = 0;
                if (scrollableDistance > 0) {
                    progress = ((scrollTop - viewTop) / scrollableDistance) * 100;
                    progress = Math.min(100, Math.max(0, progress));
                } else {
                    progress = 100;
                }
                mobileProgressFill.style.width = `${progress}%`;
            }

            window.addEventListener('scroll', updateMobileProgressBar, { passive: true });
            window.addEventListener('resize', updateMobileProgressBar, { passive: true });

            function updateActiveProjectIndicator(projectId, updateUrl = true) {
                activeProjectId = projectId;
                const project = allProjects.find(p => p.id === projectId);

                if (!project) return;

                // Update vertical nav rail links
                document.querySelectorAll('.vnav-link').forEach(link => {
                    const isCurrent = link.getAttribute('data-project-id') === projectId;
                    link.classList.toggle('active', isCurrent);
                });

                document.title = `${project.title} | Project | Sudhir Mishra`;

                if (updateUrl && window.location.hash !== `#project-${projectId}`) {
                    history.replaceState({ projectId }, '', `#project-${projectId}`);
                }
            }

            function openCaseStudy(projectId, pushState = true) {
                const project = allProjects.find(p => p.id === projectId);
                if (!project) return;

                if (siteShell) siteShell.classList.add('sidebar-collapsed');
                if (projectsSection) projectsSection.style.display = 'none';

                if (caseStudyView) {
                    caseStudyView.style.display = 'block';
                    caseStudyView.classList.remove('animating-in');
                    void caseStudyView.offsetWidth;
                    caseStudyView.classList.add('animating-in');
                }

                if (mobileJumpProjects) {
                    mobileJumpProjects.classList.remove('is-visible');
                }

                updateActiveProjectIndicator(projectId, pushState);

                // Smoothly scroll down to the selected project card in the stream
                isUserScrollingProgrammatically = true;
                setTimeout(() => {
                    const targetCard = document.getElementById(`project-card-view-${projectId}`);
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        targetCard.classList.add('active-in-view');
                    }
                    setTimeout(() => {
                        isUserScrollingProgrammatically = false;
                    }, 600);
                }, 40);

                if (pushState) {
                    history.pushState({ projectId: project.id }, '', `#project-${project.id}`);
                }
                setTimeout(updateMobileProgressBar, 80);
            }

            function closeCaseStudy(pushState = true) {
                const targetId = activeProjectId;
                activeProjectId = null;

                if (mobileProgressFill) {
                    mobileProgressFill.style.width = '0%';
                }

                if (siteShell) siteShell.classList.remove('sidebar-collapsed');

                if (caseStudyView) {
                    caseStudyView.style.display = 'none';
                }

                if (projectsSection) {
                    projectsSection.style.display = 'block';
                    projectsSection.classList.remove('animating-in');
                    void projectsSection.offsetWidth;
                    projectsSection.classList.add('animating-in');
                }

                // Scroll directly back to the project card in the grid overview!
                if (targetId) {
                    const targetCard = document.getElementById(`project-card-${targetId}`);
                    if (targetCard) {
                        setTimeout(() => {
                            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            targetCard.classList.add('card-returned-highlight');
                            setTimeout(() => {
                                targetCard.classList.remove('card-returned-highlight');
                            }, 2200);
                        }, 60);
                    }
                }

                document.title = 'Sudhir Mishra | Senior Software Engineer';

                if (pushState) {
                    history.pushState({}, '', window.location.pathname + (targetId ? `#project-card-${targetId}` : '#projects-section'));
                }
            }

            function navigateAdjacent(direction) {
                if (!activeProjectId) return;
                const idx = allProjects.findIndex(p => p.id === activeProjectId);
                const target = direction === 'prev' ? allProjects[idx - 1] : allProjects[idx + 1];
                if (target) {
                    const targetCard = document.getElementById(`project-card-view-${target.id}`);
                    if (targetCard) {
                        isUserScrollingProgrammatically = true;
                        updateActiveProjectIndicator(target.id, true);
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        setTimeout(() => {
                            isUserScrollingProgrammatically = false;
                        }, 600);
                    }
                }
            }

            // Click listener for project cards in 2-column main grid
            projectCards.forEach(card => {
                card.addEventListener('click', (e) => {
                    const cardId = card.id || '';
                    const id = cardId.replace('project-card-', '');
                    if (id) {
                        e.preventDefault();
                        openCaseStudy(id, true);
                    }
                });
            });

            // Vertical nav rail links click listeners
            document.querySelectorAll('.vnav-link').forEach(link => {
                link.addEventListener('click', () => {
                    const id = link.getAttribute('data-project-id');
                    if (id) {
                        const targetCard = document.getElementById(`project-card-view-${id}`);
                        if (targetCard) {
                            isUserScrollingProgrammatically = true;
                            updateActiveProjectIndicator(id, true);
                            targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            setTimeout(() => {
                                isUserScrollingProgrammatically = false;
                            }, 600);
                        }
                    }
                });
            });

            // IntersectionObserver for vertical scrolling through project cards in the stream
            const streamCardObserver = new IntersectionObserver((entries) => {
                if (isUserScrollingProgrammatically || !activeProjectId) return;

                entries.forEach(entry => {
                    if (entry.isIntersecting && entry.intersectionRatio >= 0.3) {
                        const id = entry.target.getAttribute('data-project-id');
                        if (id && id !== activeProjectId) {
                            updateActiveProjectIndicator(id, false);
                        }
                    }
                });
            }, {
                root: null,
                rootMargin: '-10% 0px -50% 0px',
                threshold: [0.3, 0.6]
            });

            document.querySelectorAll('.vertical-projects-stream .snackable-card').forEach(card => {
                streamCardObserver.observe(card);
            });

            // Grid View button clicks (return to 2-column grid)
            if (vnavGridBtn) vnavGridBtn.addEventListener('click', () => closeCaseStudy(true));
            if (mobileStreamGridBtn) mobileStreamGridBtn.addEventListener('click', () => closeCaseStudy(true));
            if (mobileStreamFloatingBtn) mobileStreamFloatingBtn.addEventListener('click', () => closeCaseStudy(true));
            if (railExpandBtn) railExpandBtn.addEventListener('click', () => closeCaseStudy(true));
            // Keyboard accessibility (Esc to close, Arrow keys for prev/next)
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (activeProjectId) {
                        closeCaseStudy(true);
                    }
                } else if (activeProjectId && (e.key === 'ArrowLeft' || e.key === 'ArrowUp') && !e.target.matches('input, textarea')) {
                    navigateAdjacent('prev');
                } else if (activeProjectId && (e.key === 'ArrowRight' || e.key === 'ArrowDown') && !e.target.matches('input, textarea')) {
                    navigateAdjacent('next');
                }
            });

            // Floating "Back to Projects" on mobile when scrolled down past projects section
            if (mobileJumpProjects && projectsSection) {
                window.addEventListener('scroll', () => {
                    if (activeProjectId) {
                        mobileJumpProjects.classList.remove('is-visible');
                        return;
                    }
                    const rect = projectsSection.getBoundingClientRect();
                    // If projects section has scrolled above the viewport (e.g. user scrolled past it)
                    if (rect.bottom < 100 && window.scrollY > 700) {
                        mobileJumpProjects.classList.add('is-visible');
                    } else {
                        mobileJumpProjects.classList.remove('is-visible');
                    }
                }, { passive: true });

                mobileJumpProjects.addEventListener('click', () => {
                    projectsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }

            // URL Hash & History handling
            function handleHashRoute() {
                const hash = window.location.hash || '';
                if (hash.startsWith('#project-card-')) {
                    const id = hash.replace('#project-card-', '');
                    const targetCard = document.getElementById(`project-card-${id}`);
                    if (targetCard) {
                        setTimeout(() => {
                            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            targetCard.classList.add('card-returned-highlight');
                            setTimeout(() => {
                                targetCard.classList.remove('card-returned-highlight');
                            }, 2000);
                        }, 100);
                        return;
                    }
                }
                if (hash.startsWith('#project-')) {
                    const id = hash.replace('#project-', '');
                    if (allProjects.some(p => p.id === id)) {
                        openCaseStudy(id, false);
                        return;
                    }
                }
                if (activeProjectId) {
                    closeCaseStudy(false);
                }
            }

            window.addEventListener('popstate', handleHashRoute);
            window.addEventListener('hashchange', handleHashRoute);

            // Initial load hash route check
            handleHashRoute();
        })();
    </script>
</body>
</html>
