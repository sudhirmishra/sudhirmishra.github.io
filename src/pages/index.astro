---
import { projects } from '../data/projects';

const totalCount = projects.length;
const securityCount = projects.filter(p => p.categories.includes('security')).length;
const dataCount = projects.filter(p => p.categories.includes('data')).length;
const webCount = projects.filter(p => p.categories.includes('web')).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sudhir Mishra | Senior Software Engineer</title>
    <meta name="description" content="Sudhir Mishra - Senior Software Engineer | Security Products, Web Applications & Data Systems">
    <meta property="og:title" content="Sudhir Mishra | Senior Software Engineer">
    <meta property="og:description" content="Sudhir Mishra - Senior Software Engineer | Security Products, Web Applications & Data Systems">
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script is:inline>
        (function() {
            try {
                const savedTheme = localStorage.getItem('portfolio-theme') || localStorage.getItem('portfolio_theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        :root {
            --bg-canvas: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --border-subtle: #e2e8f0;
            --border-strong: #cbd5e1;
            --text-main: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --accent: #0284c7;
            --accent-bg: #f0f9ff;
            --accent-border: #bae6fd;
            --accent-text: #0369a1;
            --featured-bg: #ecfdf5;
            --featured-border: #a7f3d0;
            --featured-text: #065f46;
            --tag-bg: #f1f5f9;
            --tag-border: #e2e8f0;
            --tag-text: #334155;
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-subtle: 0 2px 8px -2px rgba(15, 23, 42, 0.04);
            --shadow-card: 0 4px 16px -3px rgba(15, 23, 42, 0.05);
        }

        [data-theme="dark"] {
            --bg-canvas: #090d16;
            --surface: #111726;
            --surface-hover: #172033;
            --border-subtle: #1e293b;
            --border-strong: #334155;
            --text-main: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --accent-bg: #0c2340;
            --accent-border: #1e3a5f;
            --accent-text: #7dd3fc;
            --featured-bg: #062b20;
            --featured-border: #0d5f46;
            --featured-text: #6ee7b7;
            --tag-bg: #172033;
            --tag-border: #23304a;
            --tag-text: #cbd5e1;
            --shadow-subtle: 0 2px 8px -2px rgba(0, 0, 0, 0.3);
            --shadow-card: 0 4px 16px -3px rgba(0, 0, 0, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-canvas);
            color: var(--text-main);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        html {
            scroll-behavior: smooth;
        }

        /* Container Layout: Two-column desktop, single-column mobile */
        .site-shell {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 40px;
            min-height: 100vh;
            transition: gap 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .sidebar-pane {
            transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), min-width 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.3s ease;
        }

        @media (min-width: 1024px) {
            .site-shell {
                display: flex;
                justify-content: space-between;
                gap: 56px;
            }

            .site-shell.sidebar-collapsed {
                gap: 36px;
            }

            .sidebar-pane {
                position: sticky;
                top: 0;
                width: 360px;
                min-width: 320px;
                height: 100vh;
                padding: 56px 0 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: var(--border-subtle) transparent;
            }

            .site-shell.sidebar-collapsed .sidebar-pane {
                width: 72px;
                min-width: 72px;
                padding: 36px 0 32px;
                overflow: hidden;
            }

            .sidebar-full-content {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                height: 100%;
                opacity: 1;
                transition: opacity 0.2s ease, transform 0.2s ease;
                transform: translateX(0);
            }

            .site-shell.sidebar-collapsed .sidebar-full-content {
                opacity: 0;
                transform: translateX(-16px);
                pointer-events: none;
                display: none;
            }

            .sidebar-collapsed-rail {
                display: none;
                flex-direction: column;
                align-items: center;
                justify-content: space-between;
                height: 100%;
                width: 100%;
                opacity: 0;
                transform: translateX(10px);
                transition: opacity 0.25s ease 0.1s, transform 0.25s ease 0.1s;
            }

            .site-shell.sidebar-collapsed .sidebar-collapsed-rail {
                display: flex;
                opacity: 1;
                transform: translateX(0);
            }

            .sidebar-pane::-webkit-scrollbar {
                width: 4px;
            }
            .sidebar-pane::-webkit-scrollbar-thumb {
                background: var(--border-subtle);
                border-radius: 4px;
            }

            .main-content-pane {
                flex: 1;
                min-width: 0;
                padding: 56px 0 88px;
            }
        }

        @media (max-width: 1023px) {
            .site-shell {
                padding: 32px 20px 64px;
            }

            .sidebar-pane {
                width: 100%;
                margin-bottom: 40px;
                padding-bottom: 28px;
                border-bottom: 1px solid var(--border-subtle);
            }

            .site-shell.sidebar-collapsed .sidebar-pane {
                display: none;
            }

            .sidebar-collapsed-rail {
                display: none !important;
            }

            .main-content-pane {
                width: 100%;
            }
        }

        /* Sidebar Profile & Typography */
        .sidebar-top {
            display: flex;
            flex-direction: column;
        }

        .profile-header {
            margin-bottom: 20px;
        }

        .profile-name {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(1.45rem, 2.4vw, 1.85rem);
            font-weight: 800;
            letter-spacing: -0.025em;
            line-height: 1.15;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .profile-headline {
            font-size: 0.98rem;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 3px;
            letter-spacing: -0.015em;
        }

        .profile-subheadline {
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 12px;
            letter-spacing: -0.01em;
        }

        .profile-bio {
            font-size: 0.88rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* Sidebar Dividers */
        .sidebar-divider {
            height: 1px;
            background-color: var(--border-subtle);
            margin: 20px 0;
            border: none;
        }

        /* Sidebar Experience & Education ("Four Lines" Stacked Layout) & Skill Pills */
        .sidebar-exp-edu {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .sidebar-block {
            display: flex;
            flex-direction: column;
        }

        .sidebar-section-title {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .stacked-entry-list {
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .stacked-entry {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .entry-row-top {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 10px;
        }

        .entry-institution {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.015em;
            line-height: 1.25;
        }

        .entry-date {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-muted);
            white-space: nowrap;
            letter-spacing: -0.01em;
            flex-shrink: 0;
        }

        .entry-row-sub {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-secondary);
            line-height: 1.35;
        }

        /* Skill Pills: High density flex wrapping with subtle background & rounded pill corners */
        .skills-pill-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-pill {
            display: inline-flex;
            align-items: center;
            padding: 5px 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-main);
            background: var(--tag-bg);
            border: 1px solid var(--border-subtle);
            border-radius: 999px;
            line-height: 1.35;
            white-space: nowrap;
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }

        .skill-pill:hover {
            background: var(--surface-hover);
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-1px);
        }

        /* Sidebar Bottom & Socials */
        .sidebar-bottom {
            margin-top: 24px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-socials {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-secondary);
            transition: all 0.15s ease;
        }

        .social-link:hover {
            color: var(--text-main);
            border-color: var(--border-strong);
            background-color: var(--surface-hover);
        }

        .social-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .sidebar-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .theme-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .theme-toggle-btn:hover {
            border-color: var(--border-strong);
            color: var(--text-main);
            background: var(--surface-hover);
        }

        .theme-toggle-btn svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        /* Section Layout */
        .section {
            margin-bottom: 60px;
            scroll-margin-top: 40px;
        }

        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .section-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--text-main);
        }

        .section-subtitle {
            font-size: 0.84rem;
            color: var(--text-muted);
        }

        /* Filter & Search Bar */
        .project-controls {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 24px;
        }

        .search-and-filters {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 500;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .filter-btn:hover {
            background-color: var(--surface-hover);
            color: var(--text-main);
        }

        .filter-btn.active {
            background-color: var(--text-main);
            border-color: var(--text-main);
            color: var(--bg-canvas);
            font-weight: 600;
        }

        .search-wrapper {
            position: relative;
            min-width: 250px;
            flex-grow: 1;
            max-width: 360px;
        }

        .search-input {
            width: 100%;
            padding: 7px 12px 7px 32px;
            font-size: 13px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-main);
            outline: none;
            transition: border-color 0.15s ease;
        }

        .search-input:focus {
            border-color: var(--accent);
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            fill: var(--text-muted);
            pointer-events: none;
        }

        /* Projects Grid */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .project-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            box-shadow: var(--shadow-subtle);
        }

        .project-card:hover {
            border-color: var(--border-strong);
            box-shadow: var(--shadow-card);
        }

        .project-card.hidden {
            display: none;
        }

        .card-top-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .project-category-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .featured-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10.5px;
            font-weight: 600;
            padding: 2px 8px;
            background: var(--featured-bg);
            border: 1px solid var(--featured-border);
            color: var(--featured-text);
            border-radius: 9999px;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .project-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.06rem;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--text-main);
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .project-summary {
            font-size: 0.88rem;
            color: var(--text-secondary);
            line-height: 1.52;
            margin-bottom: 12px;
            flex-grow: 1;
        }

        .case-study-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 14px;
            transition: all 0.15s ease;
            text-decoration: none;
            width: fit-content;
        }

        .case-study-link:hover {
            color: var(--text-main);
            transform: translateX(3px);
        }

        .case-study-link svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
            transition: transform 0.15s ease;
        }

        .case-study-link:hover svg {
            transform: translateX(2px);
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px dashed var(--border-subtle);
        }

        .tag-pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            padding: 3px 8px;
            background: var(--tag-bg);
            border: 1px solid var(--tag-border);
            border-radius: 4px;
            color: var(--tag-text);
            white-space: nowrap;
        }

        /* Adjacent / Secondary Projects */
        .adjacent-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 20px 24px;
            margin-top: 24px;
        }

        .adjacent-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .adjacent-list {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px 24px;
        }

        .adjacent-item {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.5;
            position: relative;
            padding-left: 14px;
        }

        .adjacent-item::before {
            content: "•";
            position: absolute;
            left: 0;
            color: var(--accent);
            font-weight: bold;
        }

        .adjacent-item strong {
            color: var(--text-main);
        }

        /* Empty Search State */
        .empty-results {
            display: none;
            text-align: center;
            padding: 48px 20px;
            background: var(--surface);
            border: 1px dashed var(--border-subtle);
            border-radius: var(--radius-md);
            color: var(--text-muted);
            font-size: 0.95rem;
            grid-column: span 2;
        }

        /* Footer */
        .site-footer {
            margin-top: 64px;
            border-top: 1px solid var(--border-subtle);
            padding-top: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .footer-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-main);
            font-weight: 600;
            transition: color 0.15s ease;
        }

        .footer-action:hover {
            color: var(--accent);
        }

        /* Responsive */
        @media (max-width: 820px) {
            .site-shell {
                padding: 28px 18px 60px;
            }

            .projects-grid {
                grid-template-columns: 1fr;
            }

            .adjacent-list {
                grid-template-columns: 1fr;
            }

            .search-wrapper {
                max-width: 100%;
                width: 100%;
            }

            .empty-results {
                grid-column: span 1;
            }
        }

        /* Collapsed Rail Controls */
        .rail-top, .rail-middle, .rail-bottom {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .rail-action-btn {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .rail-action-btn:hover {
            background: var(--accent-bg);
            border-color: var(--accent);
            color: var(--accent);
            transform: scale(1.05);
        }

        .rail-action-btn svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .rail-back-btn {
            background: var(--accent-bg);
            border-color: var(--accent-border);
            color: var(--accent);
        }

        .rail-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-main);
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            letter-spacing: 0.05em;
        }

        .rail-icon-link {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            transition: all 0.2s ease;
        }

        .rail-icon-link:hover {
            color: var(--accent);
            background: var(--surface-hover);
        }

        .rail-icon-link svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        /* Basic In-Page Animations */
        @keyframes caseStudyFadeIn {
            0% {
                opacity: 0;
                transform: translateY(18px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes projectsSectionFadeIn {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes cardSwitch {
            0% {
                opacity: 0.3;
                transform: translateY(10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .case-study-view.animating-in {
            animation: caseStudyFadeIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .section.animating-in {
            animation: projectsSectionFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .case-study-card.animating-switch {
            animation: cardSwitch 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Case Study In-Page View (Vertical Project Stream & Vertical Rail) */
        .case-study-view {
            max-width: 920px;
            width: 100%;
        }

        /* Vertical Projects Layout */
        .vertical-projects-layout {
            display: flex;
            gap: 24px;
            align-items: flex-start;
            position: relative;
        }

        /* Desktop Sticky Vertical Navigation Rail */
        .vertical-nav-rail {
            width: 220px;
            flex-shrink: 0;
            position: sticky;
            top: 24px;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 14px 12px;
            box-shadow: var(--shadow-subtle);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .vnav-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: 4px;
        }

        .vnav-label {
            font-family: 'Outfit', sans-serif;
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
        }

        .vnav-grid-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.74rem;
            font-weight: 600;
            color: var(--accent);
            background: var(--accent-bg);
            border: 1px solid var(--accent);
            padding: 3px 8px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .vnav-grid-btn:hover {
            transform: translateY(-1px);
        }

        .vnav-list {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .vnav-link {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 7px 9px;
            border-radius: var(--radius-sm);
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-secondary);
            text-align: left;
            cursor: pointer;
            font-family: 'Outfit', sans-serif;
            font-size: 0.8rem;
            line-height: 1.3;
            transition: all 0.15s ease;
            width: 100%;
        }

        .vnav-link:hover {
            background: var(--surface-hover);
            color: var(--text-main);
            border-color: var(--border-subtle);
        }

        .vnav-link.active {
            background: var(--accent-bg);
            color: var(--accent);
            border-color: var(--accent);
            font-weight: 600;
        }

        .vnav-index {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: var(--text-muted);
            padding-top: 1px;
            flex-shrink: 0;
        }

        .vnav-link.active .vnav-index {
            color: var(--accent);
            font-weight: 700;
        }

        .vnav-title {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Vertical Projects Stream */
        .vertical-projects-stream {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Mobile Top Progress Bar (Like a sleek browser loading/reading indicator) */
        .mobile-reading-progress {
            display: none;
        }

        .mobile-stream-top-bar {
            display: none;
        }

        .mobile-stream-floating-btn {
            display: none;
        }

        @media (max-width: 1023px) {
            .vertical-nav-rail {
                display: none;
            }

            .site-shell.sidebar-collapsed .mobile-reading-progress {
                display: block;
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 2.5px;
                background: rgba(0, 0, 0, 0.05);
                z-index: 9999;
                pointer-events: none;
            }

            :root.theme-dark .site-shell.sidebar-collapsed .mobile-reading-progress {
                background: rgba(255, 255, 255, 0.06);
            }

            .mobile-reading-progress-fill {
                height: 100%;
                width: 0%;
                background: var(--accent);
                box-shadow: 0 0 6px var(--accent);
                transition: width 0.06s ease-out;
            }

            .mobile-stream-top-bar {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                margin-bottom: 12px;
            }

            .mobile-stream-grid-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-family: 'Outfit', sans-serif;
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--accent);
                background: var(--surface);
                border: 1px solid var(--border-subtle);
                padding: 5px 11px;
                border-radius: var(--radius-sm);
                cursor: pointer;
                transition: all 0.15s ease;
            }

            .mobile-stream-grid-btn:hover {
                background: var(--accent-bg);
                border-color: var(--accent);
            }

            .site-shell.sidebar-collapsed .mobile-stream-floating-btn {
                display: inline-flex;
                position: fixed;
                bottom: 20px;
                right: 16px;
                z-index: 90;
                align-items: center;
                gap: 6px;
                background: var(--surface);
                border: 1px solid var(--border-medium);
                color: var(--accent);
                font-family: 'Outfit', sans-serif;
                font-size: 0.78rem;
                font-weight: 600;
                padding: 8px 14px;
                border-radius: 9999px;
                box-shadow: 0 4px 18px rgba(0, 0, 0, 0.16);
                cursor: pointer;
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                transition: all 0.15s ease;
            }

            .mobile-stream-floating-btn:hover {
                background: var(--accent-bg);
                border-color: var(--accent);
                transform: translateY(-2px);
            }
        }

        /* Snackable 1-View Case Study Card */
        .case-study-card.snackable-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 16px 18px;
            box-shadow: var(--shadow-card);
            scroll-margin-top: 52px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .case-study-card.snackable-card:hover {
            border-color: var(--border-medium);
        }

        .case-study-card.snackable-card.active-in-view {
            border-color: var(--accent);
        }

        .project-heading-block {
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px dashed var(--border-subtle);
        }

        .project-heading-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 3px;
        }

        .project-meta-pill {
            display: inline-block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .project-view-index {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10.5px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .project-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--text-main);
            margin: 0;
            line-height: 1.28;
        }

        .snackable-content-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        @media (min-width: 700px) {
            .snackable-content-grid {
                grid-template-columns: 1fr 1fr;
                gap: 10px 18px;
            }

            .study-section.full-span {
                grid-column: span 2;
            }
        }

        .study-section {
            margin-bottom: 0;
        }

        .section-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--accent);
            margin-bottom: 3px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .section-body {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.45;
            margin: 0;
        }

        .approach-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin: 0;
            padding: 0;
        }

        .approach-list li {
            position: relative;
            padding-left: 14px;
            font-size: 0.83rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .approach-list li::before {
            content: '–';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--accent);
            font-weight: 700;
        }

        .stack-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 3px;
        }

        .stack-pill {
            display: inline-block;
            background: var(--tag-bg);
            border: 1px solid var(--tag-border);
            color: var(--tag-text);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            font-weight: 500;
            padding: 2px 7px;
            border-radius: var(--radius-sm);
            white-space: nowrap;
        }

        .project-card {
            cursor: pointer;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        /* Pulse highlight when returning back to a project card from a case study */
        @keyframes cardReturnPulse {
            0% {
                outline: 2px solid var(--accent);
                box-shadow: 0 0 0 6px var(--accent-bg), var(--shadow-card);
                border-color: var(--accent);
                transform: scale(1.02);
            }
            40% {
                outline: 2px solid var(--accent);
                box-shadow: 0 0 0 8px var(--accent-bg), var(--shadow-card);
                border-color: var(--accent);
                transform: scale(1.015);
            }
            100% {
                outline: 2px solid transparent;
                box-shadow: var(--shadow-card);
                border-color: var(--border-subtle);
                transform: scale(1);
            }
        }

        .project-card.card-returned-highlight {
            animation: cardReturnPulse 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            border-color: var(--accent) !important;
        }

        /* Mobile project dock decommissioned per user request (horizontal navigation replacing next/back) */
        div#site-shell:nth-of-type(1) > main#main-content-pane:nth-of-type(1) > div#mobile-cs-dock:nth-of-type(2),
        .mobile-cs-dock {
            display: none !important;
        }

        /* Mobile floating 'Back to Projects' jump button when scrolling main page */
        .mobile-jump-projects {
            display: none;
        }


            .mobile-jump-projects {
